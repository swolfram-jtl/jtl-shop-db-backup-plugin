msgstr "Storage used"

msgid "lokal"
msgstr "local"

msgid "Anzahl Backups"
msgstr "Number of backups"

msgid "Letzte Aktivität"
msgstr "Recent activity"

msgid "Noch keine Einträge."
msgstr "No entries yet."

msgid "Noch kein Backup vorhanden"
msgstr "No backup yet"

msgid "Leg dein erstes Backup an, bevor du eine der CSV-Import-Funktionen des Shops nutzt."
msgstr "Create your first backup before using one of the shop's CSV import features."

msgid "Tipp: unter „Einstellungen” lässt sich zusätzlich ein tägliches/wöchentliches Cron-Backup aktivieren."
msgstr "Tip: a daily/weekly cron backup can also be enabled under \"Settings\"."

msgid "Schnellzugriff"
msgstr "Quick access"

msgid "Erstellt"
msgstr "Created"

msgid "Status"
msgstr "Status"

