<?xml version="1.0" encoding="UTF-8"?>
<!--
  Verified against the actual shop core source (release/5.8.0), not just the
  docs — the docs page (docs/de/docs/shop_plugins/infoxml.md) turned out to
  be stale in one place (see the "encrypted" note below):
  - Root takes no attributes; <XMLVersion> is a required separate element.
  - <Setting> uses attributes (type/initialValue/conf/sort) plus a required
    <ValueName> child, not a <Type> child (SettingsLinks.php install path).
  - type="encrypted" IS a real, working value — SettingsLinks.php stores the
    type= attribute verbatim with no whitelist, and JTL\Plugin\Data\Config
    checks for InputType::ENCRYPTED specifically to XTEA-decrypt it. The
    docs' listed type list (text/textarea/.../none) simply omits it.
  - <MinShopVersion> (dotted SemVer) is parsed by PluginValidator.php via
    JTLShop\SemVer\Version and compared against APPLICATION_VERSION;
    <ShopVersion> is also accepted as a fallback, MinShopVersion taking
    priority if both are present.
  - Set to "5.7.0" rather than "5.8.0" DELIBERATELY: under strict SemVer, a
    pre-release build like "5.8.0-rc3" sorts BELOW its final "5.8.0", so a
    literal MinShopVersion="5.8.0" rejects any 5.8.0 release candidate
    (confirmed the hard way — error code 37, "Diese Version von JTL-Shop
    ist nicht mehr kompatibel", against a real 5.8.0-rc3 shop). "5.7.0"
    clears that comparison unambiguously once major/minor differ, without
    depending on how the core's SemVer library orders pre-release tags
    specifically (unverified). This plugin's PHP code itself was still only
    checked against actual release/5.8.0 source, not real 5.7.x — see
    README "Known gaps" if installing on a genuine (non-5.8) 5.7 shop.

  STILL OPEN:
  - ValueName below just mirrors Name (snake_case) — the real PHP-side
    naming convention JTL-Shop expects is not yet confirmed.
-->
<jtlshopplugin>
    <XMLVersion>102</XMLVersion>
    <Name>DB Backup Manager</Name>
    <!-- Renamed from "Database Export Import Backup Tool" (was itself renamed
         from "Database Ex/Importer Backup Tool" — the "/" triggered error
         code 6, "Der Plugin-Name entspricht nicht der Konvention"; likely a
         restricted character set for <Name>, exact allowed regex
         unconfirmed). This second rename reflects the plugin's growth from a
         pure backup/restore safety net into a full backup MANAGER (grouped,
         filterable, sortable overview; inline comments; delete). Display
         name/description/docs only — PluginID stays jtl_dbbackup_tool
         (changing it would make an already-installed instance's settings and
         history orphaned, effectively requiring a reinstall). -->
    <Description>Backup- und Restore-Sicherheitsnetz fuer die CSV-Import-Funktionen des JTL-Shop-Backends (Kunden, Newsletter, PLZ/Ort, Weiterleitungen, Gutscheine, Bewertungen, Sprachvariablen) — inklusive Backup-Manager mit Gruppierung, Filtern, Sortierung, Kommentaren und Loeschen.</Description>
    <Author>Sirko Wolfram</Author>
    <URL>https://github.com/swolfram-jtl/jtl-shop-db-backup-plugin</URL>
    <!-- CONFIRMED fatal-error fix, not just the warning: <URL> is documented
         as optional and PluginValidator never checks it, but
         Installer.php:159 reads $baseNode['URL'] with no ?? fallback
         (unlike its neighbors Icon/ExsID/StoreID) — a MISSING element makes
         $plugin->cURL null, which Meta.php:56 then passes into
         GetText::translatePluginOrCoreMessage(?string, string $original),
         whose non-nullable $original throws a fatal TypeError. Any string
         here (even "") fixes it; this is a real bug/inconsistency in
         JTL-Shop 5.8.0-rc3 itself, not something wrong in this plugin. -->
    <PluginID>jtl_dbbackup_tool</PluginID>
    <Version>0.2.0</Version>
    <CreateDate>2026-08-14</CreateDate>
    <MinShopVersion>5.7.0</MinShopVersion>

    <Install>
        <Adminmenu>
            <Customlink sort="1">
                <Name>Dashboard</Name>
                <Filename>dashboard.php</Filename>
            </Customlink>
            <Customlink sort="2">
                <Name>Erstellen</Name>
                <Filename>backup.php</Filename>
                <!-- Renamed from "Backup jetzt" — shorter, and reads better
                     next to the other tab names ("Dashboard", "Erstellen",
                     "Backups verwalten (Historie)", "Einstellungen"). File/
                     class names deliberately stay backup.php/BackupController
                     to limit churn; only the visible label changed. Every
                     form's hidden cPluginTab field in backup.tpl and
                     _partials/run-options.tpl must match this <Name> EXACTLY
                     (see dashboard.tpl's header comment for why) — updated to
                     "Erstellen" everywhere. -->
            </Customlink>
            <Customlink sort="3">
                <Name>Backups verwalten (Historie)</Name>
                <Filename>history.php</Filename>
                <!-- Renamed from "Historie & Restore" to "Wiederherstellen" to
                     "Backups", now to "Backups verwalten (Historie)" — makes
                     explicit that this tab is both the manager (group/filter/
                     sort/comment/delete) AND where restore lives, not just a
                     bare label that could read as "the backups" in a vaguer
                     sense. File/class names deliberately stay history.php/
                     HistoryController internally to limit churn; only the
                     visible label changed. Every form's hidden cPluginTab
                     field across this plugin's templates must match this
                     <Name> EXACTLY (see dashboard.tpl's header comment for
                     why) — updated everywhere. -->
            </Customlink>
            <Settingslink sort="4">
                <Name>Einstellungen</Name>

                <Setting type="text" initialValue="" conf="N" sort="1">
                    <Name>Backup-Einstellungen</Name>
                    <ValueName>section_backup</ValueName>
                    <Description></Description>
                    <!-- conf="N" = section heading (Config::TYPE_NOT_CONFIGURABLE),
                         CONFIRMED against tpl_inc/plugin_options.tpl: the
                         heading text shown is $confItem->niceName, which maps
                         to THIS <Name> element — NOT <Description> and NOT
                         initialValue (a conf="N" item's stored value is never
                         read/displayed at all). Originally had this backwards
                         (a snake_case key in <Name>, the real heading text
                         wasted on initialValue) — that key was shown verbatim
                         since translatePluginOrCoreMessage() only maps to
                         another string if a matching gettext entry exists,
                         otherwise returns the original unchanged (the admin
                         theme's .subheading1 CSS then uppercases it, hence
                         "SECTION_BACKUP" on screen). -->
                </Setting>
                <Setting type="selectbox" initialValue="ftps" conf="Y" sort="2">
                    <Name>Übertragungsprotokoll</Name>
                    <ValueName>ftp_protocol</ValueName>
                    <Description>Klartext-FTP wird aus Sicherheitsgruenden nicht unterstuetzt — nur FTPS oder SFTP.</Description>
                    <SelectboxOptions>
                        <Option value="ftps" sort="0">FTPS</Option>
                        <Option value="sftp" sort="1">SFTP</Option>
                    </SelectboxOptions>
                    <!-- Confirmed schema against docs/de/docs/shop_plugins/infoxml.md
                         lines 879-993 + SettingsLinks.php — real dropdown now,
                         not free text. <Name> changed from the raw ValueName
                         ("ftp_protocol") to a real title — same fix as the
                         section headings below, applied to every setting in
                         this file: tpl_inc/plugin_options.tpl shows THIS
                         element as the field label, not <ValueName>. -->
                </Setting>
                <Setting type="text" initialValue="" conf="Y" sort="3">
                    <Name>Host</Name>
                    <ValueName>ftp_host</ValueName>
                    <Description>Adresse des FTPS/SFTP-Servers, z. B. backup.example.com</Description>
                </Setting>
                <Setting type="text" initialValue="" conf="Y" sort="4">
                    <Name>Port</Name>
                    <ValueName>ftp_port</ValueName>
                    <Description>Leer lassen fuer den Standard-Port (FTPS: 21, SFTP: 22).</Description>
                </Setting>
                <Setting type="text" initialValue="" conf="Y" sort="5">
                    <Name>Benutzername</Name>
                    <ValueName>ftp_username</ValueName>
                    <Description></Description>
                </Setting>
                <Setting type="encrypted" initialValue="" conf="Y" sort="6">
                    <Name>Passwort</Name>
                    <ValueName>ftp_password</ValueName>
                    <Description>Fuer FTPS immer noetig; fuer SFTP nur, wenn unten kein privater Schluessel hinterlegt ist.</Description>
                </Setting>
                <Setting type="encrypted" initialValue="" conf="Y" sort="7">
                    <Name>SFTP: Privater Schlüssel</Name>
                    <ValueName>ftp_private_key</ValueName>
                    <Description>Alternative zum Passwort, nur fuer SFTP. Einzeiliges Eingabefeld — den Schluessel ggf. extern zu einer Zeile zusammenhaengend kopieren.</Description>
                </Setting>
                <Setting type="encrypted" initialValue="" conf="Y" sort="8">
                    <Name>SFTP: Passphrase des Schlüssels</Name>
                    <ValueName>ftp_private_key_passphrase</ValueName>
                    <Description>Nur noetig, wenn der obige private Schluessel selbst mit einer Passphrase geschuetzt ist.</Description>
                </Setting>
                <Setting type="text" initialValue="/" conf="Y" sort="9">
                    <Name>Zielverzeichnis</Name>
                    <ValueName>ftp_remote_dir</ValueName>
                    <Description>Verzeichnis auf dem FTPS/SFTP-Server, in das Backups hochgeladen werden.</Description>
                </Setting>
                <Setting type="checkbox" initialValue="" conf="Y" sort="10">
                    <Name>Backup verschlüsseln</Name>
                    <ValueName>encryption_enabled</ValueName>
                    <Description>Backup-Datei zusaetzlich mit XChaCha20-Poly1305 verschluesseln, bevor sie lokal gespeichert bzw. hochgeladen wird. Standard: aus. Passwort unten festlegen — ohne dieses Passwort ist ein verschluesseltes Backup spaeter nicht mehr lesbar.</Description>
                    <!-- CONFIRMED against tpl_inc/plugin_options.tpl: the core's
                         own checkbox <input> has no value= attribute, so a
                         checked box always POSTs the literal string "on"
                         (browser default), and the template re-checks the box
                         only if the stored value === "on" — "Y"/"N" was never
                         a real convention here, just an incorrect assumption
                         carried over from elsewhere. An unchecked box sends
                         nothing at all, so PluginController::actionConfig()
                         stores NULL for "off", not "N" — default-off is
                         therefore an empty initialValue, not "N". -->
                </Setting>
                <Setting type="encrypted" initialValue="" conf="Y" sort="11">
                    <Name>Verschlüsselungs-Passwort</Name>
                    <ValueName>encryption_passphrase</ValueName>
                    <Description>Nur wirksam, wenn "Backup verschluesseln" oben aktiviert ist. Wichtig: dieses Passwort verloren = betroffene Backups unlesbar, es gibt keine Wiederherstellung ohne es.</Description>
                </Setting>
                <Setting type="checkbox" initialValue="on" conf="Y" sort="12">
                    <Name>Wartungsmodus während des Backups</Name>
                    <ValueName>maintenance_mode_enabled</ValueName>
                    <Description>Shop waehrend des Backups kurz in den Wartungsmodus versetzen. Reiner Kunden-Komfort (verhindert Bestellungen mitten im Backup) — keine technische Konsistenzgarantie fuer die Backup-Datei selbst. Standard: an.</Description>
                </Setting>
                <Setting type="text" initialValue="10" conf="Y" sort="13">
                    <Name>Max. Anzahl Backups</Name>
                    <ValueName>retention_max_count</ValueName>
                    <Description>Aeltere Backups werden automatisch geloescht, sobald mehr als diese Anzahl vorhanden ist (die zuletzt erstellten bleiben immer erhalten).</Description>
                </Setting>
                <Setting type="text" initialValue="90" conf="Y" sort="14">
                    <Name>Max. Alter in Tagen</Name>
                    <ValueName>retention_max_age_days</ValueName>
                    <Description>Backups, die aelter als diese Anzahl Tage sind, werden automatisch geloescht (0 = kein Alterslimit).</Description>
                </Setting>
                <Setting type="text" initialValue="" conf="Y" sort="15">
                    <Name>Benachrichtigung bei Fehlschlag</Name>
                    <ValueName>notify_email_on_failure</ValueName>
                    <Description>E-Mail-Adresse, an die eine Nachricht geht, wenn ein Backup oder Upload fehlschlaegt. Leer lassen, um keine Benachrichtigung zu erhalten.</Description>
                </Setting>

                <Setting type="text" initialValue="" conf="N" sort="16">
                    <Name>Wiederherstellen-Einstellungen</Name>
                    <ValueName>section_restore</ValueName>
                    <Description></Description>
                </Setting>
                <Setting type="checkbox" initialValue="on" conf="Y" sort="17">
                    <Name>Vorab-Snapshot vor Restore</Name>
                    <ValueName>pre_restore_snapshot_enabled</ValueName>
                    <Description>Vor jedem Restore automatisch ein Backup des aktuellen Stands anlegen, damit ein missglueckter Restore selbst rueckgaengig gemacht werden kann. Standard: an — nur abschalten, wenn du genau weisst, warum.</Description>
                </Setting>
                <Setting type="checkbox" initialValue="on" conf="Y" sort="18">
                    <Name>Konsistenzprüfung nach Restore</Name>
                    <ValueName>post_restore_consistency_check_enabled</ValueName>
                    <Description>Nach einem Teil-Restore (z. B. nur Kunden) auf moeglicherweise verwaiste Datensaetze in anderen Tabellen pruefen und als Hinweis anzeigen. Standard: an.</Description>
                </Setting>
                <Setting type="checkbox" initialValue="on" conf="Y" sort="19">
                    <Name>Bei Strukturabweichung blockieren</Name>
                    <ValueName>version_fingerprint_block_enabled</ValueName>
                    <Description>Restore hart blockieren, wenn sich die Tabellenstruktur seit dem Backup geaendert hat (z. B. durch ein Shop-Update), statt nur zu warnen. Standard: an — sicherer, aber ein Restore laesst sich dann nur mit ausdruecklicher Bestaetigung erzwingen.</Description>
                </Setting>
            </Settingslink>
        </Adminmenu>
    </Install>
</jtlshopplugin>
